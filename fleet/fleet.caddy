# The fleet view's site, for the Caddy in ops/compose.yml (docs/FLEET.md).
# SPDX-License-Identifier: AGPL-3.0-or-later
fleet.steadyapp.co.za {
	# no compression: pages carry a CSRF token (BREACH)
	reverse_proxy fleet:8080
	header {
		-Server
		X-Robots-Tag "noindex, nofollow"
	}
	log {
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
			}
		}
	}
}
