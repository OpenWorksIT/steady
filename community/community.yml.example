## Steady Community (the forum): the discourse_docker container, behind the Caddy that owns ports
## 80/443 on OpenWorks' own server (vps3, ops/compose.yml), on the "community-edge" Docker
## network (only it and Caddy: the fleet view is on a network of its own).
##
## Copy to /var/discourse/containers/community.yml (the file name is the container's name:
## "community"; keep it, Caddy looks for that name), fill in the values marked
## CHANGE, then:   cd /var/discourse && sudo ./launcher rebuild community
## Caddy serves https://community.steadyapp.co.za and passes it on (community/community.caddy).
## It opens only inside Steady, in the Community tab, signed in as whoever is signed in to Steady,
## through the sign-in bridge at https://signin.steadyapp.co.za (community/signin/).
## Full steps: docs/COMMUNITY.md.
##
## On a server of its own instead: add templates/web.ssl.template.yml and
## templates/web.letsencrypt.ssl.template.yml, replace docker_args with
##   expose: ["80:80", "443:443"]
## and drop the real-IP lines under run:.
##
## Based on samples/standalone.yml from https://github.com/discourse/discourse_docker
## YAML is strict about spaces. Indent with spaces only, never tabs.
## Keep this file readable by root only: sudo chmod 600 containers/community.yml

templates:
  - "templates/postgres.template.yml"
  - "templates/redis.template.yml"
  - "templates/web.template.yml"
  - "templates/web.ratelimited.template.yml"

## No published ports: Caddy reaches it as community:80 on the community-edge network.
docker_args: "--network community-edge"

params:
  db_default_text_search_config: "pg_catalog.english"
  ## Shared with the fleet view on a 4 GB server: about 1/8 of the RAM.
  db_shared_buffers: "512MB"
  ## Which Discourse version to build (default: latest)
  #version: latest

env:
  LC_ALL: en_US.UTF-8
  LANG: en_US.UTF-8
  LANGUAGE: en_US.UTF-8
  DISCOURSE_DEFAULT_LOCALE: en_GB

  ## Web workers. 2 is plenty for a forum of a few dozen people.
  UNICORN_WORKERS: 2

  ## The forum's address. Discourse will not work on a bare IP address.
  DISCOURSE_HOSTNAME: "community.steadyapp.co.za"

  ## The community lead's address. The account with this email is made admin (and
  ## "developer") when it signs in. OpenWorks IT's address does NOT go here: OpenWorks sets the
  ## forum up with a one-off API key and holds no admin account (docs/COMMUNITY.md).
  DISCOURSE_DEVELOPER_EMAILS: "kempie@vrpsych.co.za"

  ## Mail: the same mailbox that sends Steady's sign-in codes (domains.co.za cPanel host).
  ## The forum sends its notifications from it (their links open the forum only inside Steady).
  ## Port 465 (SSL from the start) is set below. For 587 with STARTTLS instead, set
  ## DISCOURSE_SMTP_PORT: 587, DISCOURSE_SMTP_ENABLE_START_TLS: true and remove
  ## DISCOURSE_SMTP_FORCE_TLS.
  DISCOURSE_SMTP_ADDRESS: mail.steadyapp.co.za
  DISCOURSE_SMTP_PORT: 465
  DISCOURSE_SMTP_FORCE_TLS: true
  DISCOURSE_SMTP_ENABLE_START_TLS: false
  DISCOURSE_SMTP_USER_NAME: noreply@steadyapp.co.za
  ## CHANGE. Keep the quotes: a '#' or '$' in a password breaks it otherwise.
  DISCOURSE_SMTP_PASSWORD: "CHANGE-ME-mailbox-password"
  DISCOURSE_SMTP_DOMAIN: steadyapp.co.za
  #DISCOURSE_SMTP_AUTHENTICATION: plain # plain|login|cram_md5
  ## The From address for everything the forum sends (the mailbox itself, so the mail server
  ## doesn't refuse it).
  DISCOURSE_NOTIFICATION_EMAIL: noreply@steadyapp.co.za

  ## Caddy does HTTPS; every link the forum makes is https.
  DISCOURSE_FORCE_HTTPS: true

  ## ------------------------------------------------------------------------------------
  ## Hard rules, pinned. Any DISCOURSE_<site setting> line fixes that setting for the whole
  ## site and hides it from the admin pages, so nobody can switch it off by accident from
  ## the browser. Changing one needs this file and a rebuild. See docs/COMMUNITY.md.
  ## ------------------------------------------------------------------------------------
  ## Sign in to see anything. Who joins is decided by Steady and the sign-in bridge (its address
  ## lists), so there are no invitations, and no sign-up on the forum itself.
  DISCOURSE_LOGIN_REQUIRED: true
  DISCOURSE_INVITE_ONLY: false
  ## The only way in: Steady's Community tab, as whoever is signed in to Steady there (password,
  ## authenticator code, linked device), through the sign-in bridge, which lets in psychologists
  ## and OpenWorks support only. The forum's own two-step sign-in is off: Steady asks for the
  ## code, and Discourse doesn't allow both. See docs/COMMUNITY.md, "Signing in through Steady".
  DISCOURSE_ENABLE_DISCOURSE_CONNECT: true
  DISCOURSE_DISCOURSE_CONNECT_CSRF_PROTECTION: true
  DISCOURSE_DISCOURSE_CONNECT_URL: "https://signin.steadyapp.co.za/discourse"
  ## CHANGE: the same as "forumSecret" in the bridge's /var/lib/steady-signin/config.json
  ## (make one with: sudo docker compose -f community/signin/compose.yml run --rm signin newkey).
  ## Keep the quotes.
  DISCOURSE_DISCOURSE_CONNECT_SECRET: "CHANGE-ME-forum-secret"
  DISCOURSE_ENFORCE_SECOND_FACTOR: "no"
  ## Name and email address always as Steady has them; nobody changes them on the forum.
  DISCOURSE_AUTH_OVERRIDES_EMAIL: true
  DISCOURSE_AUTH_OVERRIDES_NAME: true
  DISCOURSE_EMAIL_EDITABLE: false
  ## After signing out: a page that says so, rather than straight back to signing in.
  DISCOURSE_LOGOUT_REDIRECT: "https://signin.steadyapp.co.za/signed-out"
  ## Every visit to the Community tab signs in again, as whoever is in Steady then; a session
  ## nobody uses ends after 12 hours (one still in use doesn't: Admin > Users > Log out).
  DISCOURSE_MAXIMUM_SESSION_AGE: 12
  ## Shown in a frame of Steady's web app: Caddy says which pages may frame it
  ## (community/community.caddy, frame-ancestors), so Discourse adds no frame rule of its own.
  DISCOURSE_ALLOW_EMBEDDING_SITE_IN_AN_IFRAME: true
  DISCOURSE_CONTENT_SECURITY_POLICY_FRAME_ANCESTORS: false
  ## Nothing else: no forum passwords, no emailed one-click login links, no passkeys.
  DISCOURSE_ENABLE_LOCAL_LOGINS: false
  DISCOURSE_ENABLE_LOCAL_LOGINS_VIA_EMAIL: false
  DISCOURSE_ENABLE_PASSKEYS: false
  DISCOURSE_ENABLE_DISCOURSE_ID: false
  ## No social or third-party logins (core and bundled plugins).
  DISCOURSE_ENABLE_GOOGLE_OAUTH2_LOGINS: false
  DISCOURSE_ENABLE_GITHUB_LOGINS: false
  DISCOURSE_ENABLE_TWITTER_LOGINS: false
  DISCOURSE_ENABLE_FACEBOOK_LOGINS: false
  DISCOURSE_ENABLE_DISCORD_LOGINS: false
  DISCOURSE_ENABLE_LINKEDIN_OIDC_LOGINS: false
  DISCOURSE_SIGN_IN_WITH_APPLE_ENABLED: false
  DISCOURSE_MICROSOFT_AUTH_ENABLED: false
  DISCOURSE_OPENID_CONNECT_ENABLED: false
  DISCOURSE_OAUTH2_ENABLED: false
  DISCOURSE_ENABLE_LOGIN_WITH_AMAZON: false
  DISCOURSE_LTI_ENABLED: false
  DISCOURSE_PATREON_LOGIN_ENABLED: false
  ## Nothing about the forum leaves the server: no usage statistics to Discourse (this also
  ## closes /site/statistics.json, which otherwise answers without signing in), no listing on
  ## Discourse Discover, and no AI features (they send posts to an outside language model).
  DISCOURSE_SHARE_ANONYMIZED_STATISTICS: false
  DISCOURSE_INCLUDE_IN_DISCOURSE_DISCOVER: false
  DISCOURSE_DISCOURSE_AI_ENABLED: false

## The container keeps nothing itself; everything (database, uploads, backups) is in /shared.
volumes:
  - volume:
      host: /var/discourse/shared/standalone
      guest: /shared
  - volume:
      host: /var/discourse/shared/standalone/log/var-log
      guest: /var/log

## Plugins. docker_manager is the one in the official sample (update page in Admin).
hooks:
  after_code:
    - exec:
        cd: $home/plugins
        cmd:
          - git clone https://github.com/discourse/docker_manager.git

run:
  ## Behind Caddy: take the visitor's address from X-Forwarded-For, believed only from the
  ## Docker networks (where Caddy is), so sign-in rate limits count each visitor, not Caddy.
  - file:
      path: /etc/nginx/conf.d/outlets/server/real-ip.conf
      chmod: 644
      contents: |
        real_ip_header X-Forwarded-For;
        set_real_ip_from 172.16.0.0/12;
        set_real_ip_from 10.0.0.0/8;
        set_real_ip_from 192.168.0.0/16;

  ## Redis answers only inside the container. Discourse's template opens it, without a
  ## password, to every Docker network the container is on; the forum itself connects locally.
  ## (Its database listens there too, but its accounts have no password, so nobody can sign in
  ## over the network.) Check after a rebuild: sudo docker exec community redis-cli CONFIG GET bind
  - replace:
      filename: "/etc/redis/redis.conf"
      from: "protected-mode no"
      to: "protected-mode yes"
  - exec: echo "bind 127.0.0.1 -::1" >> /etc/redis/redis.conf
