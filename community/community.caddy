# The community forum's site, for the Caddy in ops/compose.yml (docs/COMMUNITY.md).
# Discourse runs as the container "community" on the edge network.
# SPDX-License-Identifier: AGPL-3.0-or-later
community.steadyapp.co.za {
	reverse_proxy community:80
	header {
		-Server
		X-Robots-Tag "noindex, nofollow"
	}
	log {
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Api-Key delete
			}
		}
	}
}
