# Steady deployment settings. Copy to .env and fill in. Never commit .env.

# On a server whose ports 80/443 already belong to another Caddy (e.g. vps1 with Shap),
# uncomment this; see docs/DEPLOY.md, "Sharing a server".
# COMPOSE_FILE=docker-compose.yml:behind-proxy.yml

# Public address of the server (DNS must point here) and the email for TLS certificates
STEADY_DOMAIN=steady.example.co.za
ACME_EMAIL=it@example.co.za

# The practice's name, tagline and logo are installed with ./brand.sh (kept in deploy/brand,
# outside the code). This older setting is only used when no brand is installed.
#STEADY_PRACTICE_NAME=Your practice
# Bump this whenever you change server/pb_hooks/content/consent.md
STEADY_CONSENT_VERSION=draft-1
# Optional: replace the built-in crisis numbers (JSON list of {label, number, hours})
# STEADY_CRISIS_LINES_JSON=[{"label":"SADAG Suicide Crisis Line","number":"0800 567 567","hours":"24 hours, free"}]

# Two-step sign-in for psychologists and administrators (a code from an authenticator app).
# Leave on. "off" only for a demo server without real patients.
STEADY_REQUIRE_2FA=staff

# Optional: the key Sorted uses to show a patient's Steady feed beside the consult note
# (docs/SORTED.md). Make one with: openssl rand -hex 32. Empty = the feed is off.
STEADY_INTEGRATION_KEY=

# Shared secret between the server and the push relay (gen-keys.sh makes one)
PUSHER_SECRET=

# UnifiedPush / Web Push (gen-keys.sh makes the key and prints the public half)
VAPID_SUBJECT=mailto:it@example.co.za
STEADY_VAPID_PUBLIC_KEY=

# Apple Push Notification service (iOS). From developer.apple.com > Keys, with APNs enabled.
# Put the .p8 file in deploy/secrets/ and refer to it as /secrets/<name>.p8
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
# The iOS app's bundle identifier
APNS_TOPIC=za.co.openworks.steady

# Where invite QR codes send iPhones: the TestFlight public link (https://testflight.apple.com/join/...)
# while Steady is in testing, later its App Store link. Empty: iPhones use the web app.
STEADY_IOS_URL=

# Optional, off by default: Firebase delivery for Android (service-account JSON in deploy/secrets/)
FCM_CREDENTIALS_FILE=

# Lets ./health.sh and OpenWorks IT's dashboard read this server's health (./gen-keys.sh prints one)
STEADY_MONITOR_KEY=

# Email to staff, from the Steady mailbox (steadyapp.co.za): the 6-digit code that links a new
# phone or browser, and notices about their own account (a reset, a lock, a new device). Never
# anything about patients. Once set, staff sign in only from linked devices. Port 587 uses
# STARTTLS; port 465 uses TLS from the start (STEADY_SMTP_TLS=on).
STEADY_SMTP_HOST=
STEADY_SMTP_PORT=587
STEADY_SMTP_USER=noreply@steadyapp.co.za
STEADY_SMTP_PASSWORD=
STEADY_MAIL_FROM=noreply@steadyapp.co.za
STEADY_MAIL_NAME=Steady
