{
	email {$ACME_EMAIL}
}

{$STEADY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	# The PocketBase dashboard and superuser sign-in are not on the internet, from anywhere:
	# accounts.sh does account work from inside the server (docs/DEPLOY.md, step 5). An
	# address allow-list here isn't safe: Docker can hand on connections from its own private
	# addresses. PocketBase refuses these from outside its container as well.
	@dashboard path_regexp dashboard (?i)^/(_|_/.*|api/collections/(_superusers|pbc_3142635823)(/.*)?)$
	respond @dashboard 404

	handle {
		# the web app: only this site's own code, fonts and API (tested with the Flutter build)
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		reverse_proxy pocketbase:8090 {
			# keep realtime (server-sent events) connections open
			flush_interval -1
		}
	}

	log {
		output stdout
		# JSON, without query strings, credentials or device and monitor keys (request bodies are
		# never logged)
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Steady-Device delete
				request>headers>X-Steady-Monitor delete
				request>headers>X-Steady-Fleet delete
			}
		}
	}
}
