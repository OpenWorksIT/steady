[Unit]
Description=Steady: the server's security and privacy check, for OpenWorks' fleet view
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
# the results go to out/, which the server hands to the fleet view with its status (docs/FLEET.md)
ExecStart=/opt/steady/deploy/audit-server.sh --quiet --json /var/lib/steady/ctl/out/audit.json
# "something to fix" is a result, not a failure of the service
SuccessExitStatus=1
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
# it reads the host's settings and changes nothing: keep it away from the rest of the system
# (not PrivateDevices: the disk encryption check reads the block devices)
ProtectSystem=full
PrivateTmp=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
