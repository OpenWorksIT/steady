# Test stack: plain HTTP inside Docker; Cloudflare handles HTTPS.
# SPDX-License-Identifier: AGPL-3.0-or-later
{
	auto_https off
	admin off
}

:80 {
	# dashboard and superuser endpoints stay local (use http://localhost:8090/_/ on this PC)
	# (by name and by the collection's id, in any letter case: the test stack's own scripts use
	# the superuser API through the local port, so the server lets it through)
	@admin path_regexp admin (?i)^/(_|_/.*|api/collections/(_superusers|pbc_3142635823)(/.*)?)$
	respond @admin 404

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	reverse_proxy pocketbase:8090 {
		flush_interval -1
	}
}
